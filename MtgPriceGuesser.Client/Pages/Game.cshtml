@page
@model GameModel
@{
    ViewData["Title"] = "Game";
}

<div class="text-center">
    <h1 class="game-title">Which card is more expensive?</h1>

    @if (!Model.HasGuessed)
    {
        <form method="post" asp-page-handler="Guess">
            <input type="hidden" name="cardAName" value="@Model.CardA.Name" />
            <input type="hidden" name="cardAImage" value="@Model.CardA.ImageUrl" />
            <input type="hidden" name="cardABackImage" value="@Model.CardA.BackImageUrl" />
            <input type="hidden" name="cardAPrice" value="@Model.CardA.Price" />

            <input type="hidden" name="cardBName" value="@Model.CardB.Name" />
            <input type="hidden" name="cardBImage" value="@Model.CardB.ImageUrl" />
            <input type="hidden" name="cardBBackImage" value="@Model.CardB.BackImageUrl" />
            <input type="hidden" name="cardBPrice" value="@Model.CardB.Price" />

            <div class="row justify-content-center align-items-center">

                @if (!string.IsNullOrEmpty(Model.CardA.BackImageUrl))
                {
                    <div class="col-auto">
                        <button type="button" class="btn btn-outline-light" onclick="flipCard('cardAImg', '@Model.CardA.ImageUrl', '@Model.CardA.BackImageUrl')">⟲ Flip</button>
                    </div>
                }

                <div class="col-md-5 mb-4">
                    <div class="card bg-dark text-white border-light">
                        <img id="cardAImg" src="@Model.CardA.ImageUrl" class="card-img-top mx-auto mt-3" style="max-width: 250px;" alt="@Model.CardA.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@Model.CardA.Name</h5>
                            <button type="submit" name="chosenCard" value="A" class="btn btn-primary">This one is pricier</button>
                        </div>
                    </div>
                </div>

                <div class="col-md-5 mb-4">
                    <div class="card bg-dark text-white border-light">
                        <img id="cardBImg" src="@Model.CardB.ImageUrl" class="card-img-top mx-auto mt-3" style="max-width: 250px;" alt="@Model.CardB.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@Model.CardB.Name</h5>
                            <button type="submit" name="chosenCard" value="B" class="btn btn-primary">This one is pricier</button>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.CardB.BackImageUrl))
                {
                    <div class="col-auto">
                        <button type="button" class="btn btn-outline-light" onclick="flipCard('cardBImg', '@Model.CardB.ImageUrl', '@Model.CardB.BackImageUrl')">⟲ Flip</button>
                    </div>
                }

            </div>
        </form>
    }
    else
    {
        <p class="score-display">
            @(Model.WasCorrect ? "✅ Correct!" : "❌ Wrong!")
        </p>

        <div class="row justify-content-center">
            <div class="col-md-5 mb-4">
                <div class="card bg-dark text-white border-light">
                    <img src="@Model.CardA.ImageUrl" class="card-img-top mx-auto mt-3" style="max-width: 250px;" alt="@Model.CardA.Name" />
                    <div class="card-body">
                        <h5 class="card-title">@Model.CardA.Name</h5>
                        <p>$@Model.CardA.Price</p>
                    </div>
                </div>
            </div>

            <div class="col-md-5 mb-4">
                <div class="card bg-dark text-white border-light">
                    <img src="@Model.CardB.ImageUrl" class="card-img-top mx-auto mt-3" style="max-width: 250px;" alt="@Model.CardB.Name" />
                    <div class="card-body">
                        <h5 class="card-title">@Model.CardB.Name</h5>
                        <p>$@Model.CardB.Price</p>
                    </div>
                </div>
            </div>
        </div>

        <form method="get">
            <button type="submit" class="btn btn-primary mt-3">Next Round</button>
        </form>
    }

    <a class="btn btn-secondary mt-3" href="/">Back to Menu</a>
</div>

@section Scripts {
    <script>
        function flipCard(imgId, frontUrl, backUrl) {
            const img = document.getElementById(imgId);
            img.src = (img.src.includes(encodeURI(frontUrl)) || img.src === frontUrl) ? backUrl : frontUrl;
        }
    </script>
}