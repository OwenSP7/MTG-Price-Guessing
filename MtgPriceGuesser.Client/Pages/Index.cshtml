@page
@model IndexModel
@{
    ViewData["Title"] = "Main Menu";
}

<div class="text-center">
    <h1 class="display-4">MTG Price Guesser</h1>

    <div class="mt-4">
        <a class="btn btn-primary btn-lg" href="/Game">Start Game</a>
    </div>

    <div class="mt-5">
        <h3>High Scores</h3>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Score</th>
                    <th>Net Worth</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TopScores.Count == 0)
                {
                    <tr>
                        <td colspan="3">No high scores yet</td>
                    </tr>
                }
                else
                {
                    @foreach (var score in Model.TopScores)
                    {
                        <tr>
                            <td>@score.PlayerName</td>
                            <td>@score.Score</td>
                            <td>$@score.NetWorth</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>