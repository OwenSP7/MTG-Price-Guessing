@page
@model IndexModel
@{
    ViewData["Title"] = "Main Menu";
}

<div class="text-center">
    <h1 class="display-4">MTG Price Guesser</h1>

    <div class="mt-4">
        <a class="btn btn-primary btn-lg" href="/Game">Start Game</a>
    </div>

    <div class="mt-5">
        <h3>High Scores</h3>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="2">No high scores yet</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>